{
  "version": 1,
  "listener": {"address": "127.0.0.1", "port": 18080},
  "ipv6": true,
  "upstream": {"type": "socks5", "host": "127.0.0.1", "port": 1080},
  "policy": {"mode": "uid_allowlist", "uids": [10234], "bypass_uids": [0]},
  "udp": {"mode": "pass"},
  "bpf": {"object": "./build/redirect.bpf.o", "cgroup": "/sys/fs/cgroup"},
  "runtime_dir": "/tmp/ebpf-proxy",
  "logging": {"level": "info"},
  "connect_timeout_seconds": 10,
  "idle_timeout_seconds": 300,
  "max_connections": 4096
}
